{
  "name": "nostube",
  "private": false,
  "version": "0.2.46",
  "type": "module",
  "scripts": {
    "dev": "npm i && vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && eslint && vite build && vite build --config vite.embed.config.ts && cp dist/index.html dist/404.html",
    "build:instance": "npm run typecheck && eslint && VITE_INSTANCE_BUILD=true vite build --outDir dist-instance",
    "start": "vite preview --port 8080 --host ::",
    "test": "npm i && npm run typecheck && eslint && vitest run && vite build && vite build --config vite.embed.config.ts",
    "deploy": "npm run build && npx -y surge@latest dist",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "trust:refresh-snapshot": "tsx scripts/refresh-trust-snapshot.ts",
    "format:staged": "npx prettier --write --ignore-unknown",
    "server:dev": "npx tsx --watch server/standalone.ts",
    "tauri": "tauri",
    "desktop:prepare-sidecar": "cargo build --manifest-path ../../../almond/Cargo.toml --release && mkdir -p src-tauri/binaries && cp ../../../almond/target/release/almond src-tauri/binaries/almond-aarch64-apple-darwin",
    "desktop:dev": "npm run desktop:prepare-sidecar && tauri dev",
    "desktop:build": "npm run desktop:prepare-sidecar && CI=true tauri build"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.13.1",
    "@contextvm/sdk": "^0.14.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nostube/core": "*",
    "@nostube/widgets": "*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "applesauce-accounts": "^7.1.0",
    "applesauce-actions": "^7.1.1",
    "applesauce-common": "^7.1.1",
    "applesauce-core": "^7.1.3",
    "applesauce-extra": "^7.3.0",
    "applesauce-loaders": "^7.2.0",
    "applesauce-react": "^7.1.0",
    "applesauce-relay": "^7.1.1",
    "applesauce-signers": "^7.1.0",
    "applesauce-wallet": "^7.1.1",
    "applesauce-wallet-connect": "^7.1.0",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "hash-wasm": "^4.13.0",
    "hls.js": "^1.7.4",
    "hono": "^4.13.19",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "immer": "^11.2.10",
    "lucide-react": "^1.76.0",
    "mediabunny": "^1.66.1",
    "minisearch": "^7.2.0",
    "mp4box": "^2.5.0",
    "next-themes": "^0.4.6",
    "ngeohash": "^0.6.4",
    "nostr-tools": "^2.26.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.1",
    "react-i18next": "^18.0.3",
    "react-intersection-observer": "^11.0.1",
    "react-router-dom": "^7.18.6",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@html-eslint/parser": "^0.68.0",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
