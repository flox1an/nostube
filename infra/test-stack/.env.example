# Copy to .env and customize as needed.
# This file is safe to commit; .env should not be committed.

# Required by divico-dvm at startup. Replace with your operator pubkey.
OPERATOR_NPUB=npub1sg6plzptd64u62a878hep2kev88swjh3tw00gjsfl8f237lmu63q0uf63m

# Host ports (macOS + Linux friendly defaults, avoid common collisions)
NOSTUBE_PORT=18080
ALMOND_PORT=13000
DVM_PORT=15207
RELAY_PORT=18081
IMGPROXY_PORT=18082

# Nostube runtime config exposed to the browser
# Important: these should be host-reachable URLs, not Docker service names.
RUNTIME_RELAYS=ws://localhost:18081
RUNTIME_BLOSSOM_SERVERS=http://localhost:13000
RUNTIME_APP_TITLE=nostube (test-stack)
RUNTIME_DEBUG=true

# Optional logging + timings
ALMOND_RUST_LOG=info
DVM_RUST_LOG=info
SMOKE_WAIT_TIMEOUT_SECONDS=180

# Optional: default divico bootstrap relay list
DVM_BOOTSTRAP_RELAYS=ws://relay:8080
