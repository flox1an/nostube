{
  "name": "nostube",
  "private": false,
  "version": "0.2.40",
  "type": "module",
  "scripts": {
    "dev": "npm i && vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "tsc -p tsconfig.app.json --noEmit && eslint && vite build && vite build --config vite.embed.config.ts && cp dist/index.html dist/404.html",
    "start": "vite preview --port 8080 --host ::",
    "test": "npm i && tsc -p tsconfig.app.json --noEmit && eslint && vitest run && vite build && vite build --config vite.embed.config.ts",
    "deploy": "npm run build && npx -y surge@latest dist",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "format:staged": "npx prettier --write --ignore-unknown",
    "server:dev": "npx tsx --watch server/standalone.ts",
    "tauri": "tauri",
    "desktop:prepare-sidecar": "cargo build --manifest-path ../almond/Cargo.toml --release && mkdir -p src-tauri/binaries && cp ../almond/target/release/almond src-tauri/binaries/almond-aarch64-apple-darwin",
    "desktop:dev": "npm run desktop:prepare-sidecar && tauri dev",
    "desktop:build": "npm run desktop:prepare-sidecar && CI=true tauri build",
    "prepare": "husky"
  },
