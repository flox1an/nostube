{
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/v/:nevent", "destination": "/api/v/:nevent" },
    { "source": "/short/:nevent", "destination": "/api/short/:nevent" },
    { "source": "/playlist/:nip19", "destination": "/api/playlist/:nip19" },
    { "source": "/oembed", "destination": "/api/oembed" },
    { "source": "/((?!api(?:/|$)|\\.well-known/).*)", "destination": "/index.html" }
  ]
}
